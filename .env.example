VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_MAPBOX_TOKEN=your-public-mapbox-token
# Enable only after the management migration, functions, and Stripe test flow pass.
VITE_BLOOM_ENABLED=false

# Local development only; requires a server endpoint scoped to an approved sandbox tester.
VITE_BLOOM_SANDBOX_CHECKOUT=false

# Email-code sign-in is the default after hosted template and delivery verification.
VITE_PASSWORDLESS_ENABLED=true
